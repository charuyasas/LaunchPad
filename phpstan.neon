includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    excludePaths:
        # Pest closures bind $this at runtime, which PHPStan can't see.
        # The top-level tests/ folder is likewise not analysed.
        - app/Dashboard/modules/*/Tests/*

    level: 7
